---
eleventyNavigation:
  key: Links
  order: 5
---

{%- css %}
ul.links {
	--_link-1: var(--brodie-red);
	--_link-2: var(--brodie-pink);
	--_link-3: var(--brodie-yellow);
	--_link-4: var(--brodie-green);
	--_link-5: var(--brodie-blue);
	--_link-6: var(--brodie-black);

	margin-inline: 0;
	margin-block: 8px 40px;
	padding: 0;
	list-style: none;
}

ul.links > li {
	margin-block: min(32px, 10%);
	margin-inline: auto;
}

ul.links li a {
	padding-block: min(24px, 10%);
	padding-inline: min(24px, 10%) min(32px, 10%);
	border-radius: 8px;
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	transition: 0.2s;
	background: var(--color-dark);
	border: 2px solid;
	text-decoration-thickness: 0.1em;
	outline-offset: 1px;
}

ul.links li a svg {
	--_size: 2em;
	inline-size: var(--_size);
	block-size: var(--_size);
	fill: currentColor;
}

ul.links li:nth-child(6n + 1) a svg {
	color: var(--_link-1);
}
ul.links li:nth-child(6n + 2) a svg {
	color: var(--_link-2);
}
ul.links li:nth-child(6n + 3) a svg {
	color: var(--_link-3);
}
ul.links li:nth-child(6n + 4) a svg {
	color: var(--_link-4);
}
ul.links li:nth-child(6n + 5) a svg {
	color: var(--_link-5);
}

ul.links li:nth-child(6n + 1) a {
	border-color: var(--_link-1);
}
ul.links li:nth-child(6n + 2) a {
	border-color: var(--_link-2);
}
ul.links li:nth-child(6n + 3) a {
	border-color: var(--_link-3);
}
ul.links li:nth-child(6n + 4) a {
	border-color: var(--_link-4);
}
ul.links li:nth-child(6n + 5) a {
	border-color: var(--_link-5);
}

ul.links li:hover a {
	transform: translateY(-2px);
}

ul.links li:active a {
	transform: translateY(0);
}
{% endcss %}

